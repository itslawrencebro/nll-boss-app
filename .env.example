# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=https://newlimitslegacy.com/logistics

# Subpath Deployment (set to /logistics/ when building static bundle for newlimitslegacy.com/logistics)
VITE_BASE_PATH=/

# Lead Ownership & Routing
DEFAULT_LEAD_OWNER=Sean Frierson

# Airtable CRM Integration (Server-side only — never expose in browser)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Logistics Leads

# n8n Workflow Webhook Adapter (Server-side only — never expose in browser)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Optional Verified Contact / Scheduler Overrides
PUBLIC_CONTACT_EMAIL=contact@newlimitslegacy.com
PUBLIC_CONTACT_PHONE=
VERIFIED_SCHEDULER_URL=
